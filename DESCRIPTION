Package: anaStatsUEB
Title: Statistical Analysis Functions for the Statistics and
    Bioinformatics Unit (UEB, VHIR)
Version: 0.0.0.9000
Authors@R:c(
    person("Miriam", "Mota", , "miriam.mota@vhir.org", role = c("aut", "cre")),
    person("Marcos", "Esteve Hernandez", , "marcos.esteve@vhir.org", role = "aut"),
